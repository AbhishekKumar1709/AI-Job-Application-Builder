// Prisma schema for AI Job Application Builder
// Dev datasource is SQLite (file-based, zero setup). Swap provider to
// "postgresql" and set DATABASE_URL for production before shipping.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
