# Copy this file to .env and fill in real values. Never commit .env.

# Prisma / database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# NextAuth (email+password via Credentials provider)
NEXTAUTH_URL="http://localhost:1001"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# AI provider — not yet integrated. Placeholder for when AI features are built.
# ANTHROPIC_API_KEY=
