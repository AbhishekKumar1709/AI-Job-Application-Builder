# Copy this file to .env and fill in real values. Never commit .env.

# Prisma / database (Postgres, hosted on Neon via Vercel's Marketplace integration)
# Pooled connection, used by the app at runtime (lib/prisma.ts)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct/unpooled connection, used only for migrations (prisma.config.ts)
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"
# Get both from: Vercel dashboard > Storage > (your Neon database) > .env.local tab
# or run `vercel env pull` if the project is linked.

# NextAuth (email+password via Credentials provider)
NEXTAUTH_URL="http://localhost:1001"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# MSG91 (SMS OTP verification)
MSG91_AUTH_KEY=
# Create a Send OTP template in the MSG91 dashboard (search "Create
# Template" or go to OTP > Templates) with the variable ##OTP## in the
# message body, then paste its Template ID here. See README's "Phone/OTP
# verification setup" section for details, including the DLT requirement
# for real SMS delivery in India.
MSG91_TEMPLATE_ID=

# Resend (password reset emails)
# Sign up free at resend.com and copy the API key from the dashboard. No
# domain verification needed to send to your own account's email address;
# verify a domain later to send to arbitrary recipients.
RESEND_API_KEY=
# Sender shown on reset emails. onboarding@resend.dev works out of the box
# in sandbox mode (delivers only to your own Resend account email).
EMAIL_FROM="onboarding@resend.dev"

# AI provider (Google Gemini) — powers resume optimization suggestions,
# ATS compatibility checks, job description matching, and cover letter
# generation. Free tier, no credit card required — get a key at
# aistudio.google.com/apikey.
GEMINI_API_KEY=
# Optional — defaults to gemini-3-flash-preview if unset.
# GEMINI_MODEL=
